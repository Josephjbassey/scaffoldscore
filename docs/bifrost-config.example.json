{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {"enable_logging": true, "enforce_auth_on_inference": false},
  "providers": {
    "groq": {"keys": [{"name": "groq", "value": "env.GROQ_API_KEY", "models": ["*"], "weight": 1.0}]},
    "gemini": {"keys": [{"name": "gemini", "value": "env.GEMINI_API_KEY", "models": ["*"], "weight": 1.0}]},
    "openrouter": {"keys": [{"name": "openrouter", "value": "env.OPENROUTER_API_KEY", "models": ["*"], "weight": 1.0}]}
  }
}
